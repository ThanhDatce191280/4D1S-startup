# ==============================================================================
# Unity .gitignore standard (Optimized for Unity 6 & URP)
# ==============================================================================

# Never commit Unity generated cache and temporary files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log

# Asset store tools and cache
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / JetBrains Rider / VS Code solution & project files
# (Unity will regenerate these automatically when opened in the IDE)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
.vsconfig
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler and crash traces
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reporter
sysinfo.txt

# JetBrains Rider and Resharper caches
.idea/
*.DotSettings.user

# Visual Studio Code workspace cache
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# Builds output directory
*.apk
*.aab
*.unitypackage
*.app
*.exe


# QA test runner and local CLI cache
.dotnet-cli/
.nuget.qa.config
QaUnityProject/
QaUnityRun/
